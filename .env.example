NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Preview exercises the frontend without creating orders or charging money.
# Connected mode uses special-affair-api. Set preview only for isolated design work.
NEXT_PUBLIC_COMMERCE_MODE=api
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_AUDIENCE=

# Server-only credentials for the private administration workspace.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
